# Public Expo configuration. Values in EXPO_PUBLIC_* are bundled into the app.
EXPO_PUBLIC_RUNTIME_TARGET=cloud-development
EXPO_PUBLIC_CONVEX_URL=https://your-development-deployment.convex.cloud
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=

# Written by `npx convex dev` after selecting the SkillFlow cloud project.
CONVEX_DEPLOYMENT=

# Set server-side with `npx convex env set`; do not put it in Expo public config.
# CLERK_JWT_ISSUER_DOMAIN=https://your-instance.clerk.accounts.dev
