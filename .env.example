# Public Expo configuration. Values in EXPO_PUBLIC_* are bundled into the app.
EXPO_PUBLIC_CONVEX_URL=http://127.0.0.1:3210
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=

# Local Convex CLI configuration. Never expose the admin key to Expo code.
CONVEX_SELF_HOSTED_URL=http://127.0.0.1:3210
CONVEX_SELF_HOSTED_ADMIN_KEY=

# Convex backend authentication configuration; supplied after Clerk provisioning.
CLERK_JWT_ISSUER_DOMAIN=
