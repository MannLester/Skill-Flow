{
  "name": "skill-flow",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "dependencies": {
    "@clerk/expo": "^4.6.1",
    "@expo-google-fonts/poppins": "^0.4.1",
    "@expo/metro-runtime": "~57.0.14",
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "convex": "^1.45.0",
    "expo": "^57.0.0",
    "expo-auth-session": "~57.0.10",
    "expo-constants": "~57.0.16",
    "expo-font": "~57.0.2",
    "expo-linking": "~57.0.8",
    "expo-router": "~57.0.17",
    "expo-secure-store": "~57.0.2",
    "expo-splash-screen": "~57.0.8",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.3",
    "expo-web-browser": "~57.0.2",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "~0.21.0"
  },
  "devDependencies": {
    "@edge-runtime/vm": "^5.0.0",
    "@expo/ngrok": "^4.1.3",
    "@react-native/jest-preset": "^0.86.3",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.2.2",
    "@types/react-dom": "~19.2.3",
    "convex-test": "^0.0.56",
    "eslint": "^9.39.1",
    "eslint-config-expo": "~57.0.2",
    "expo-doctor": "^1.20.4",
    "jest": "29.7.0",
    "jest-expo": "~57.0.5",
    "react-test-renderer": "19.2.3",
    "typescript": "~6.0.3",
    "vitest": "^4.1.11"
  },
  "scripts": {
    "start": "expo start",
    "start:client": "expo start --go --tunnel --clear",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "web:export": "expo export --platform web",
    "web:preview": "node scripts/preview-static-web.cjs",
    "web:verify": "npm run web:export && node scripts/verify-static-web-preview.cjs",
    "convex:bootstrap": "node -- scripts/setup-convex-local.mjs bootstrap",
    "convex:up": "node -- scripts/setup-convex-local.mjs up",
    "convex:down": "node -- scripts/setup-convex-local.mjs down",
    "convex:status": "node -- scripts/setup-convex-local.mjs status",
    "convex:logs": "node -- scripts/setup-convex-local.mjs logs",
    "convex:health": "node -- scripts/setup-convex-local.mjs health",
    "convex:dev": "node -- scripts/setup-convex-local.mjs dev",
    "seed:preview": "node -- scripts/convex-cloud-seed.mjs preview",
    "seed:candidates": "node -- scripts/convex-cloud-seed.mjs candidates",
    "seed:apply": "node -- scripts/convex-cloud-seed.mjs apply",
    "seed:reset": "node -- scripts/convex-cloud-seed.mjs reset",
    "lint": "node -- scripts/check-eslint-suppressions.cjs && node -- scripts/check-eslint-complexity-debt.cjs && eslint . --max-warnings 0 --report-unused-disable-directives-severity off --suppressions-location eslint-suppressions.json",
    "lint:prune": "node -- scripts/prune-eslint-baselines.cjs",
    "runtime-bundle": "node -- scripts/check-runtime-bundle.cjs",
    "typecheck": "tsc --noEmit",
    "test": "jest --runInBand",
    "test:convex": "vitest run",
    "verify": "npm run typecheck && npm run lint && npm test -- --watch=false && npm run test:convex && npx expo export --platform android",
    "doctor": "npx expo-doctor",
    "verify:android-device": "node scripts/verify-android-device.mjs"
  },
  "jest": {
    "preset": "jest-expo",
    "moduleNameMapper": {
      "^@/context/session\\.remote$": "<rootDir>/src/context/session.tsx"
    },
    "setupFilesAfterEnv": [
      "<rootDir>/jest.setup.js"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/references/",
      "<rootDir>/convex/",
      "<rootDir>/\\.codex-run/",
      "<rootDir>/\\.agent-worktrees/"
    ]
  },
  "private": true
}
