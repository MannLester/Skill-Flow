{
  "name": "skill-flow",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "dependencies": {
    "@expo-google-fonts/poppins": "^0.4.1",
    "@expo/metro-runtime": "~6.1.2",
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "convex": "^1.45.0",
    "expo": "~54.0.0",
    "expo-constants": "~18.0.14",
    "expo-font": "~14.0.12",
    "expo-linking": "~8.0.12",
    "expo-router": "~6.0.24",
    "expo-splash-screen": "~31.0.13",
    "expo-status-bar": "~3.0.9",
    "expo-system-ui": "~6.0.9",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-web": "~0.21.0"
  },
  "devDependencies": {
    "@expo/ngrok": "^4.1.3",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.1.10",
    "eslint": "^9.39.1",
    "eslint-config-expo": "~10.0.0",
    "expo-doctor": "1.17.1",
    "jest": "29.7.0",
    "jest-expo": "~54.0.18",
    "react-test-renderer": "19.1.0",
    "typescript": "~5.9.2"
  },
  "scripts": {
    "start": "expo start",
    "start:client": "expo start --go --tunnel --clear",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "convex:bootstrap": "node -- scripts/setup-convex-local.mjs bootstrap",
    "convex:up": "node -- scripts/setup-convex-local.mjs up",
    "convex:down": "node -- scripts/setup-convex-local.mjs down",
    "convex:status": "node -- scripts/setup-convex-local.mjs status",
    "convex:logs": "node -- scripts/setup-convex-local.mjs logs",
    "convex:health": "node -- scripts/setup-convex-local.mjs health",
    "convex:dev": "node -- scripts/setup-convex-local.mjs dev",
    "lint": "node -- scripts/check-eslint-suppressions.cjs && node -- scripts/check-eslint-complexity-debt.cjs && eslint . --max-warnings 0 --suppressions-location eslint-suppressions.json",
    "lint:prune": "node -- scripts/prune-eslint-baselines.cjs",
    "typecheck": "tsc --noEmit",
    "test": "jest --runInBand",
    "verify": "npm run typecheck && npm run lint && npm test -- --watch=false && npx expo export --platform android",
    "doctor": "npx expo-doctor"
  },
  "jest": {
    "preset": "jest-expo",
    "setupFilesAfterEnv": [
      "<rootDir>/jest.setup.js"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/references/",
      "<rootDir>/\\.agent-worktrees/"
    ]
  },
  "private": true
}
